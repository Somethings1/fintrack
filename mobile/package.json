{
  "name": "fintrack-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "export": "expo export --platform all --output-dir dist",
    "check:deps": "expo install --check"
  },
  "dependencies": {
    "@fintrack/client": "file:../packages/fintrack-client",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "~57.0.17",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {"node": ">=22.13 <23"}
}
