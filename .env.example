# Copy to .env, keep it outside version control, and restrict permissions to its owner.
# Production: use a dedicated application user, TLS and a replica set; never expose MongoDB ports.
MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/finance_db?retryWrites=true&w=majority
MONGO_DATABASE=finance_db
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
ALLOWED_ORIGINS=https://finance.example.com
HTTP_PORT=8088
BIND_ADDRESS=127.0.0.1
IMAGE_TAG=local
# Opt in only after configuring provider billing, data processing and model availability.
AGENT_ENABLED=false
GEMINI_API_KEY=
AGENT_MODEL=
