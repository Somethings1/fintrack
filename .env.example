# Copy to .env, keep it outside version control, and restrict permissions to its owner.
# Production: use the PostgreSQL connection string for the same Supabase project used for auth.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_SUPABASE_DB_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
ALLOWED_ORIGINS=https://finance.example.com
HTTP_PORT=8088
BIND_ADDRESS=127.0.0.1
# Use exact references from the approved release manifest, never :latest.
API_IMAGE=fintrack-api:local
WEB_IMAGE=fintrack-web:local
EDGE_IMAGE=fintrack-edge:local
APP_DOMAIN=finance.example.com
ACME_EMAIL=REPLACE_OPERATOR_EMAIL
CRON_ENABLED=false
# Opt in only after configuring provider billing, data processing and model availability.
AGENT_ENABLED=false
GEMINI_API_KEY=
AGENT_MODEL=
# Operator switch: disables all NEW AI change proposals, including legacy drafts.
# This does not disable normal manual CRUD endpoints or revoke previously issued cards.
AGENT_CHANGES_DISABLED=false
# Optional tariff snapshot for estimates, NOT user billing. All three or all unset.
# Integers in micro-USD per ONE MILLION tokens. Obtain the current selected-model rates.
# Unset means UNKNOWN COST, not free. Explicit zero is accepted.
AGENT_INPUT_MICRO_USD_PER_MILLION=
AGENT_CACHED_MICRO_USD_PER_MILLION=
AGENT_OUTPUT_MICRO_USD_PER_MILLION=

# Immutable currency for this ledger; changing the display label is not FX conversion.
LEDGER_CURRENCY=USD
